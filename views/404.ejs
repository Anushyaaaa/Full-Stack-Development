<%- include('partials/header') %>

<main class="error-page-container">
    <div class="error-card">
        <div class="error-code gradient-text">404</div>
        <h1 style="font-size: 1.8rem; margin-bottom: 12px; color: #fff;">Page Not Found</h1>
        <p style="color: var(--text-body); line-height: 1.6; margin-bottom: 28px;">
            <%= typeof message !== 'undefined' ? message : "The campus page or resource you are looking for doesn't exist or has moved." %>
        </p>
        <div style="display: flex; gap: 14px; justify-content: center; flex-wrap: wrap;">
            <a href="/" class="btn-primary">
                <span>Return to Home</span>
            </a>
            <a href="/events" class="btn-secondary">
                <span>Explore Events</span>
            </a>
        </div>
    </div>
</main>

<%- include('partials/footer') %>
