                    <div class="feature-icon-wrapper icon-blue">
                        <svg viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                            <line x1="16" y1="2" x2="16" y2="6"></line>
                            <line x1="8" y1="2" x2="8" y2="6"></line>
                            <line x1="3" y1="10" x2="21" y2="10"></line>
                        </svg>
                    </div>
                    <h3>Event Discovery</h3>
                    <p>Find technical, cultural, sports and academic events happening across campus.</p>
                    <a href="/events" class="feature-link">
                        Explore Discoveries &rarr;
                    </a>
                </div>

                <div class="feature-card">
                    <div class="feature-icon-wrapper icon-purple">
                        <svg viewBox="0 0 24 24" fill="none" stroke="#8b5cf6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                            <circle cx="9" cy="7" r="4"></circle>
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                        </svg>
                    </div>
                    <h3>Club Management</h3>
                    <p>Discover student clubs, communities and organizations that match your interests.</p>
                    <a href="/clubs" class="feature-link">
                        Browse Clubs &rarr;
                    </a>
                </div>

                <div class="feature-card">
                    <div class="feature-icon-wrapper icon-cyan">
                        <svg viewBox="0 0 24 24" fill="none" stroke="#06b6d4" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                            <polyline points="14 2 14 8 20 8"></polyline>
                            <line x1="16" y1="13" x2="8" y2="13"></line>
                            <line x1="16" y1="17" x2="8" y2="17"></line>
                        </svg>
                    </div>
                    <h3>Smart Registration</h3>
                    <p>Register for events quickly and keep track of everything in one place.</p>
                    <a href="/register" class="feature-link">
                        Instant Access &rarr;
                    </a>
                </div>

                <div class="feature-card">
                    <div class="feature-icon-wrapper icon-pink">
                        <svg viewBox="0 0 24 24" fill="none" stroke="#ec4899" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="2" y1="12" x2="22" y2="12"></line>
                            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1 4-10z"></path>
                        </svg>
                    </div>
                    <h3>Student Community</h3>
                    <p>Connect with students who share your interests, goals and passions.</p>
                    <a href="/students" class="feature-link">
                        Meet Members &rarr;
                    </a>
                </div>

                <div class="feature-card">
                    <div class="feature-icon-wrapper icon-amber">
                        <svg viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                            <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                        </svg>
                    </div>
                    <h3>Event Notifications</h3>
                    <p>Stay updated about upcoming events, registrations and important announcements.</p>
                    <a href="/events" class="feature-link">
                        Never Miss Out &rarr;
                    </a>
                </div>

                <div class="feature-card">
                    <div class="feature-icon-wrapper icon-emerald">
                        <svg viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="18" y1="20" x2="18" y2="10"></line>
                            <line x1="12" y1="20" x2="12" y2="4"></line>
                            <line x1="6" y1="20" x2="6" y2="14"></line>
                        </svg>
                    </div>
                    <h3>Campus Analytics</h3>
                    <p>Understand participation and engagement through meaningful campus insights.</p>
                    <a href="/#about" class="feature-link">
                        View Insights &rarr;
                    </a>
                </div>

            </div>
        </div>
    </section>

    <!-- ==========================================================================
         UPCOMING EVENTS SECTION (Dynamic Server-Side Rendered from Database)
         ========================================================================== -->
    <section class="events-section" id="events">
        <div class="container">
            <div class="section-header">
                <span class="section-tag">Campus Calendar</span>
                <h2 class="section-title">Upcoming Events</h2>
                <p class="section-subtitle">
                    Live events loaded dynamically from the Events Database &amp; REST API.
                </p>
            </div>

            <div class="events-grid">
                <% if (upcomingEvents && upcomingEvents.length > 0) { %>
                    <% upcomingEvents.forEach(event => { %>
                        <% 
                           let badgeClass = 'badge-tech';
                           if (event.category.toLowerCase().includes('cultur')) badgeClass = 'badge-cultural';
                           else if (event.category.toLowerCase().includes('sport')) badgeClass = 'badge-sports';
                           else if (event.category.toLowerCase().includes('acad')) badgeClass = 'badge-academic';
                           
                           // Extract date parts
                           let day = '24';
                           let month = 'OCT';
                           if (event.date) {
                               const parts = event.date.split('-');
                               if (parts.length === 3) {
                                   day = parts[2];
                                   const mIdx = parseInt(parts[1], 10) - 1;
                                   const months = ['JAN','FEB','MAR','APR','MAY','JUN','JUL','AUG','SEP','OCT','NOV','DEC'];
                                   month = months[mIdx] || 'OCT';
                               }
                           }
                        %>
                        <article class="event-card">
                            <div class="event-thumbnail-wrap">
                                <img class="event-thumbnail" src="<%= event.image %>" alt="<%= event.title %>">
                                <div class="event-overlay"></div>
                                <span class="event-badge <%= badgeClass %>"><%= event.category %></span>
                                <div class="event-date-pill">
                                    <div class="day"><%= day %></div>
                                    <div class="month"><%= month %></div>
                                </div>
                            </div>
                            <div class="event-content">
                                <div class="event-meta-info">
                                    <span>&#128205; <%= event.venue %></span>
                                    <span>&#128101; <%= event.registeredCount %> Registered</span>
                                </div>
                                <h3><%= event.title %></h3>
                                <p><%= event.description %></p>
                                <div class="event-footer">
                                    <span style="font-size: 0.8rem; color: #10b981; font-weight: 600;"><%= event.time %></span>
                                    <a href="/events/<%= event.eventId %>" class="event-action-link">
                                        <span>View Event</span>
                                        <span>&rarr;</span>
                                    </a>
                                </div>
                            </div>
                        </article>
                    <% }) %>
                <% } else { %>
                    <p style="grid-column: 1 / -1; text-align: center; color: var(--text-muted);">No upcoming events currently scheduled.</p>
                <% } %>
            </div>

            <div style="text-align: center; margin-top: 40px;">
                <a href="/events" class="btn-secondary">
                    <span>View All Campus Events &rarr;</span>
                </a>
            </div>
        </div>
    </section>

    <!-- ==========================================================================
         CLUBS SECTION (Dynamic Server-Side Rendered from Database)
         ========================================================================== -->
    <section class="clubs-section" id="clubs">
        <div class="container">
            <div class="section-header">
                <span class="section-tag">Student Organizations</span>
                <h2 class="section-title">Find Your People</h2>
                <p class="section-subtitle">
                    Join communities that turn shared interests into meaningful experiences.
                </p>
            </div>

            <div class="clubs-grid">
                <% if (featuredClubs && featuredClubs.length > 0) { %>
                    <% featuredClubs.forEach(club => { %>
                        <div class="club-card">
                            <div class="club-image-wrap">
                                <img class="club-image" src="<%= club.image %>" alt="<%= club.name %>">
                                <div class="club-overlay"></div>
                                <span class="club-badge"><%= club.category %></span>
                            </div>
                            <div class="club-body">
                                <h3><%= club.name %></h3>
                                <p><%= club.description %></p>
                                <div class="club-footer">
                                    <span class="member-count">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="#8b5cf6"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
                                        <%= club.members %>+ Members
                                    </span>
                                    <a href="/clubs/<%= club.clubId %>" class="club-link">
                                        <span>Explore Club &rarr;</span>
                                    </a>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                <% } %>
            </div>

            <div style="text-align: center; margin-top: 40px;">
                <a href="/clubs" class="btn-secondary">
                    <span>Explore All Clubs &rarr;</span>
                </a>
            </div>
        </div>
    </section>

    <!-- ==========================================================================
         COMMUNITY SECTION (SPLIT LAYOUT)
         ========================================================================== -->
