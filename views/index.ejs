<%- include('partials/header') %>

<main>

    <!-- ==========================================================================
         HERO SECTION
         ========================================================================== -->
    <section class="hero-section" id="hero">
        <div class="container">
            <div class="hero-grid">
                
                <!-- Hero Content Left -->
                <div class="hero-content">
                    <div class="hero-badge">
                        <span class="live-dot"></span>
                        <span class="hero-badge-text">SMART CAMPUS • CONNECT • COLLABORATE • CREATE</span>
                    </div>

                    <h1 class="hero-title">
                        Your Campus.<br>
                        <span class="gradient-text">Your Community.</span><br>
                        Your Events.
                    </h1>

                    <p class="hero-description">
                        One intelligent platform to discover college events, join clubs, connect with students, and build unforgettable campus experiences.
                    </p>

                    <div class="hero-cta-group">
                        <a href="/events" class="btn-primary">
                            <span>Explore Events</span>
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                                <polyline points="12 5 19 12 12 19"></polyline>
                            </svg>
                        </a>
                        <a href="/clubs" class="btn-secondary">
                            <span>Discover Clubs</span>
                        </a>
                    </div>

                    <a href="/students" class="hero-trust-link">
                        Built for modern campus communities &rarr;
                    </a>
                </div>

                <!-- Hero Visual Right (Glassmorphic Mockup & Floating Cards) -->
                <div class="hero-visual-container">
                    
                    <!-- Floating Satellite Card 1: Upcoming Event -->
                    <div class="floating-card card-satellite-1">
                        <div class="sat-tag">Upcoming Event</div>
                        <div class="sat-title">TechFest 2026</div>
                        <div class="sat-sub">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#8b5cf6" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                            <span>24 OCT • 10:00 AM</span>
                        </div>
                    </div>

                    <!-- Central Glass Dashboard Visual -->
                    <div class="hero-main-card">
                        <div class="card-topbar">
                            <div class="window-controls">
                                <span class="ctrl-red"></span>
                                <span class="ctrl-yellow"></span>
                                <span class="ctrl-green"></span>
                            </div>
                            <div class="card-search-pill">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                                <span>campusly.internal/hub</span>
                            </div>
                        </div>
                        <div class="card-media">
                            <img src="https://images.unsplash.com/photo-1531482615713-2afd69097998?auto=format&fit=crop&w=1200&q=80" alt="Students collaborating at an active campus innovation hub">
                            <div class="card-media-overlay"></div>
                            <span class="card-live-tag">&#9679; LIVE CAMPUS FEED</span>
                        </div>
                        <div class="card-body-content">
                            <h3>National Hackathon &amp; Innovation Expo</h3>
                            <p>Over 40 colleges competing for the $10,000 Grand Prize. Keynote by AI leaders.</p>
                            <div class="card-metric-row">
                                <div class="avatar-group">
                                    <img src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?auto=format&fit=crop&w=100&q=80" alt="Student participant">
                                    <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=100&q=80" alt="Student participant">
                                    <img src="https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&w=100&q=80" alt="Student participant">
                                    <div class="avatar-count">+480</div>
                                </div>
                                <span style="font-size: 0.78rem; font-weight: 700; color: var(--neon-cyan);">Auditorium Hall A</span>
                            </div>
                        </div>
                    </div>

                    <!-- Floating Satellite Card 2: Club Spotlight -->
                    <div class="floating-card card-satellite-2">
                        <div class="sat-club-flex">
                            <div class="sat-club-icon">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="#ffffff"><path d="M12 2a2 2 0 0 1 2 2c0 .74-.4 1.39-1 1.73V7h1a7 7 0 0 1 7 7h1a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1h-1v1a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-1H2a1 1 0 0 1-1-1v-3a1 1 0 0 1 1-1h1a7 7 0 0 1 7-7h1V5.73c-.6-.34-1-.99-1-1.73a2 2 0 0 1 2-2z"/></svg>
                            </div>
                            <div>
                                <div class="sat-tag">Club Spotlight</div>
                                <div class="sat-title">AI &amp; Robotics Club</div>
                                <div style="font-size: 0.75rem; color: #10b981; font-weight: 600;">+128 Members This Week</div>
                            </div>
                        </div>
                    </div>

                    <!-- Floating Satellite Card 3: Event Registration -->
                    <div class="floating-card card-satellite-3">
                        <div class="progress-header">
                            <span class="progress-title">Event Registration</span>
                            <span class="progress-val">87% Filled</span>
                        </div>
                        <div class="progress-bar-track">
                            <div class="progress-bar-fill"></div>
                        </div>
                    </div>

                </div>

            </div>
        </div>
    </section>

    <!-- ==========================================================================
         CAMPUS STATISTICS STRIP (Calculated Server-Side from Database)
         ========================================================================== -->
    <section class="stats-section" aria-label="Campus Statistics">
        <div class="container">
            <div class="stats-glass-strip">
                <div class="stat-item">
                    <div class="stat-number gradient-text"><%= stats.totalClubs %>+</div>
                    <div class="stat-label">Active Clubs</div>
                </div>
                <div class="stat-item">
                    <div class="stat-number gradient-text"><%= stats.totalEvents %>+</div>
                    <div class="stat-label">Annual Events</div>
                </div>
                <div class="stat-item">
                    <div class="stat-number gradient-text"><%= typeof stats.totalStudents === 'number' && stats.totalStudents > 1000 ? Math.floor(stats.totalStudents/1000) + 'K+' : stats.totalStudents + '+' %></div>
                    <div class="stat-label">Student Members</div>
                </div>
                <div class="stat-item">
                    <div class="stat-number gradient-text"><%= stats.engagementRate %></div>
                    <div class="stat-label">Student Engagement</div>
                </div>
            </div>
        </div>
    </section>

    <!-- ==========================================================================
         FEATURES SECTION
         ========================================================================== -->
